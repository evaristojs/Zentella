# N8N Webhook Configuration
# Copy this file to .env and add your actual webhook URL
VITE_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/contact-form

# Instructions:
# 1. Create a webhook trigger in N8N
# 2. Copy the webhook URL from N8N
# 3. Replace the URL above with your actual webhook URL
# 4. The webhook will receive form data in JSON format with these fields:
#    - name: string
#    - email: string  
#    - phone: string
#    - service: string
#    - budget: string
#    - message: string
#    - timestamp: ISO date string
#    - source: "zentella-contact-form"